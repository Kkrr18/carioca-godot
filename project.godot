; CARIOCA — configuração do projeto Godot 4.4
; Mundo aberto do Estado do Rio de Janeiro em escala 1:1.
; Editado à mão de propósito: o projeto não deve depender de nada fora do
; próprio repositório para abrir e rodar.

config_version=5

[application]

config/name="CARIOCA"
config/description="Mundo aberto do Estado do Rio de Janeiro — fundação geográfica 2.0."
run/main_scene="res://core/bootstrap/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
; A web só suporta Compatibility no Godot 4.4; o resto do jogo segue em Mobile.
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.529, 0.706, 0.851, 1)
